# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used to generate answers. Groq deprecates/renames models fairly
# often, so if you get a 404 "model does not exist" error, check
# console.groq.com/docs/models for the current model names on your account.
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (multilingual, works well with Spanish)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Local Whisper model size for speech-to-text (tiny/base/small/medium)
# "small" is a good speed/accuracy tradeoff for Spanish.
WHISPER_MODEL_SIZE=small

# Path to the Piper voice model (.onnx) used for Spanish text-to-speech.
# See README for download instructions.
PIPER_MODEL_PATH=models/es_ES-davefx-medium.onnx

# Number of context chunks retrieved per question
TOP_K=4
